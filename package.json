{
  "name": "antigravity-telegram-mcp",
  "version": "2.1.0",
  "description": "AetherLink Telegram MCP plugin with secure one-time pairing, ChatGPT OAuth 2.1, and local/remote transports",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "node start.mjs",
    "dev": "npx tsx src/index.ts",
    "start:remote": "node remote.mjs",
    "test:oauth": "node test/oauth-smoke.mjs",
    "configure": "node scripts/configure.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "grammy": "^1.35.0",
    "dotenv": "^16.4.7",
    "playwright": "^1.49.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0"
  }
}
