# Local plugin mode normally asks for this in a setup window and stores it in ~/.aetherlink/config.json.
TELEGRAM_BOT_TOKEN=
RESPONSE_TIMEOUT_MS=300000
GEMINI_API_KEY=

# Remote / ChatGPT Web deployment
PORT=3000
HOST=0.0.0.0
# Strong random string. Remote endpoint becomes /mcp/<MCP_PATH_KEY>.
# Example: openssl rand -hex 32
MCP_PATH_KEY=
# Optional persistent location. Mount this as a volume in production.
AETHERLINK_DATA_DIR=/data
