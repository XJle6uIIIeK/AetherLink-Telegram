# Required in production: exact public HTTPS origin, without /mcp.
PUBLIC_URL=https://aetherlink.example.com

# HTTP listener
HOST=0.0.0.0
PORT=3000

# Persistent application data. Mount this directory/volume in Docker.
AETHERLINK_DATA_DIR=/data

# Optional. If omitted, a random 32-byte master key is created in AETHERLINK_DATA_DIR/master.key.
# Keep this value stable if you set it, otherwise saved Telegram bot tokens cannot be decrypted.
# AETHERLINK_MASTER_KEY=replace-with-a-long-random-secret

# OAuth / pairing lifetimes
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_SESSION_TTL_SECONDS=900
PAIRING_TTL_SECONDS=600

# Telegram request timeout
RESPONSE_TIMEOUT_MS=300000

# Optional speech transcription used by the legacy Telegram voice-task flow.
# GEMINI_API_KEY=
